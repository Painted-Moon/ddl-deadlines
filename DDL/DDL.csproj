<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the notification-area icon (NotifyIcon); the UI itself is WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DDL</RootNamespace>
    <AssemblyName>DDL</AssemblyName>
    <Product>DDL</Product>
    <AssemblyTitle>DDL</AssemblyTitle>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets\ddl.ico</ApplicationIcon>
    <!-- Application.ThemeMode (Windows 11 Fluent look) is still marked experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Optional: with a portable .NET SDK in ..\..\.tools\dotnet (next to the repo folder),
       let the published exe in .\app find that runtime instead of a system-wide install. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\.tools\dotnet\dotnet.exe') And '$(SelfContained)' != 'true'">
    <AppHostDotNetSearch>AppRelative;EnvironmentVariable;Global</AppHostDotNetSearch>
    <AppHostRelativeDotNet>..\..\.tools\dotnet</AppHostRelativeDotNet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep WinForms/Drawing names out of the WPF code (Application, MessageBox, Color, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\ddl.ico" />
  </ItemGroup>

</Project>
