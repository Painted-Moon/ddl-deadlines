<Window x:Class="DDL.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDL" AutomationProperties.AutomationId="TaskEditor"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <StackPanel Margin="28,14,28,24">
        <TextBlock x:Name="HeaderText" Text="New deadline" FontFamily="{StaticResource DisplayFont}"
                   FontSize="22" FontWeight="SemiBold" />

        <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="TitleBox" FontSize="15" TextChanged="OnInputChanged" AutomationProperties.Name="Title" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="130" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Due date" Style="{StaticResource FieldLabel}" />
                <DatePicker x:Name="DuePicker" SelectedDateChanged="OnInputChanged" AutomationProperties.Name="Due date" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Time" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="TimeBox" IsEditable="True" MaxDropDownHeight="240"
                          TextBoxBase.TextChanged="OnInputChanged" SelectionChanged="OnInputChanged"
                          ToolTip="Pick or type a 24-hour time, e.g. 18:45" AutomationProperties.Name="Due time" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Remind me (pick any)" Style="{StaticResource FieldLabel}" />
        <WrapPanel x:Name="ReminderChips" AutomationProperties.Name="Reminders" />

        <!-- Opened by the "+ Custom" pill -->
        <StackPanel x:Name="CustomPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBox x:Name="CustomAmountBox" Width="64" TextChanged="OnCustomAmountChanged"
                     PreviewKeyDown="OnCustomAmountKeyDown" AutomationProperties.Name="Custom reminder amount" />
            <ComboBox x:Name="CustomUnitBox" Width="112" Margin="8,0,0,0" SelectedIndex="1"
                      AutomationProperties.Name="Custom reminder unit">
                <ComboBoxItem Content="minutes" Tag="1" />
                <ComboBoxItem Content="hours" Tag="60" />
                <ComboBoxItem Content="days" Tag="1440" />
            </ComboBox>
            <TextBlock Text="before" Margin="8,0" VerticalAlignment="Center" />
            <Button x:Name="AddCustomButton" Content="Add" MinWidth="64" IsEnabled="False" Click="OnAddCustomClick" />
        </StackPanel>

        <TextBlock x:Name="ReminderSummary" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,0" />

        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,10,0,6" />
        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Notes" />

        <Border x:Name="HintBox" Visibility="Collapsed" Margin="0,14,0,0" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="13" />
        </Border>

        <DockPanel Margin="0,24,0,0" LastChildFill="False">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" MinWidth="88" Click="OnDeleteClick"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.Name="Delete">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="Delete" />
                </StackPanel>
            </Button>
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save" MinWidth="96" Margin="8,0,0,0"
                    IsDefault="True" Click="OnSaveClick" Style="{DynamicResource AccentButtonStyle}" />
            <Button DockPanel.Dock="Right" Content="Cancel" MinWidth="96" IsCancel="True" />
        </DockPanel>
    </StackPanel>
</Window>
