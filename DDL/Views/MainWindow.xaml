<Window x:Class="DDL.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DDL.ViewModels"
        xmlns:views="clr-namespace:DDL.Views"
        Title="DDL" Width="1000" Height="620" MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterScreen">

    <Window.CommandBindings>
        <!-- Ctrl+N -->
        <CommandBinding Command="ApplicationCommands.New" Executed="OnNewExecuted" />
    </Window.CommandBindings>

    <Window.Resources>
        <!-- The card's delete button fades in when it appears. -->
        <Style x:Key="CardDeleteButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One deadline card. The whole card is a button: click or Enter opens the editor. -->
        <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type vm:TaskRow}">
            <Button x:Name="CardButton" Style="{StaticResource BareButton}" Click="OnRowClick" Margin="0,0,0,8"
                    AutomationProperties.Name="{Binding Title}">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Edit" Click="OnRowClick" />
                        <MenuItem Header="{Binding ToggleLabel}" Click="OnToggleMenuClick" />
                        <Separator />
                        <MenuItem Header="Delete" Click="OnDeleteClick" />
                    </ContextMenu>
                </Button.ContextMenu>

                <Grid>
                <Border x:Name="Card" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                    <!-- Fades in on hover -->
                    <Border x:Name="HoverLayer" CornerRadius="7" Opacity="0"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Grid Margin="14,12,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Style="{StaticResource RoundCheck}" VerticalAlignment="Top" Margin="0,0,12,0"
                                  IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                  Checked="OnCheckChanged" Unchecked="OnCheckChanged"
                                  ToolTip="{Binding ToggleLabel}"
                                  AutomationProperties.Name="{Binding ToggleAutomationName}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE787;" FontSize="11" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding DueText}" />
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0"
                                            Visibility="{Binding HasReminder, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xEA8F;" FontSize="11" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding ReminderText}" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding NotesPreview}" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Border x:Name="Pill" Grid.Column="2" CornerRadius="10" Padding="9,2,9,3" Margin="12,0,0,0"
                                VerticalAlignment="Top" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="PillText" Text="{Binding PillText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>

                        <!-- Takes the pill's place while the card is hovered or focused. -->
                        <Button x:Name="DeleteButton" Grid.Column="2" Style="{StaticResource CardDeleteButton}" Content="&#xE74D;"
                                Margin="0,-6,-6,-6" VerticalAlignment="Top" HorizontalAlignment="Right" Visibility="Collapsed"
                                Click="OnDeleteClick" ToolTip="Delete"
                                AutomationProperties.Name="{Binding DeleteAutomationName}" />
                    </Grid>
                    </Grid>
                </Border>
                <!-- Brief accent ring for a new or just-edited card (animated from code) -->
                <Border x:Name="Glow" CornerRadius="8" BorderThickness="2" Opacity="0" IsHitTestVisible="False"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                </Grid>
            </Button>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Urgency}" Value="{x:Static vm:Urgency.Overdue}">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Urgency}" Value="{x:Static vm:Urgency.Soon}">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Urgency}" Value="{x:Static vm:Urgency.Done}">
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter TargetName="TitleText" Property="TextDecorations" Value="Strikethrough" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Setter TargetName="TitleText" Property="FontWeight" Value="Normal" />
                </DataTrigger>
                <Trigger SourceName="CardButton" Property="IsMouseOver" Value="True">
                    <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Pill" Property="Visibility" Value="Hidden" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger SourceName="CardButton" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="DeleteButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Pill" Property="Visibility" Value="Hidden" />
                </Trigger>
                <Trigger SourceName="CardButton" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A group of cards with its header. "Completed" can be collapsed. -->
        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vm:TaskSection}">
            <StackPanel Margin="0,0,0,6">
                <Grid x:Name="SectionHeader" Margin="2,10,0,8">
                    <StackPanel x:Name="PlainHeader" Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Count}" FontSize="13" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <ToggleButton x:Name="FoldHeader" Visibility="Collapsed" IsChecked="{Binding IsExpanded}"
                                  Checked="OnSectionToggled" Unchecked="OnSectionToggled"
                                  Cursor="Hand" HorizontalAlignment="Left" FocusVisualStyle="{x:Null}"
                                  AutomationProperties.Name="{Binding Title}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="0,2,6,2"
                                        BorderThickness="1" BorderBrush="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Chevron" Style="{StaticResource IconText}" Text="&#xE76C;" FontSize="10"
                                       Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Count}" FontSize="13" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
                <ItemsControl x:Name="Cards" ItemsSource="{Binding Rows}" Focusable="False"
                              ItemTemplate="{StaticResource TaskCardTemplate}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCollapsible}" Value="True">
                    <Setter TargetName="PlainHeader" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FoldHeader" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                    <Setter TargetName="Cards" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <!-- Arrow points down while open; code adds a short turn when the user clicks (OnSectionToggled). -->
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="328" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: today, month calendar, counts -->
        <Border Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,20,18,18">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,0,0">
                    <TextBlock x:Name="TodayWeekday" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TodayDate" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                               FontWeight="SemiBold" Margin="0,1,0,0" />
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Margin="0,0,0,-6" Padding="8,6"
                        Click="OnStartupClick" ToolTip="Start DDL quietly in the notification area when you sign in"
                        AutomationProperties.Name="Start with Windows">
                    <DockPanel>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7E8;" FontSize="12" Margin="0,0,10,0" />
                        <TextBlock x:Name="StartupStatus" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Start with Windows" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Margin="0,8,0,0" Padding="8,6"
                        Click="OnCalendarSyncClick" ToolTip="Show your deadlines in Outlook"
                        AutomationProperties.Name="Calendar sync">
                    <DockPanel>
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE895;" FontSize="12" Margin="0,0,10,0" />
                        <TextBlock x:Name="SyncStatus" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Text="Outlook sync" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>

                <UniformGrid DockPanel.Dock="Bottom" Columns="3">
                    <Border Style="{StaticResource StatTile}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock x:Name="OverdueCount" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="Overdue" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="2,0,2,0">
                        <StackPanel>
                            <TextBlock x:Name="TodayCount" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="Due today" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock x:Name="WeekCount" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="Next 7 days" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <views:MonthCalendar x:Name="Calendar" Margin="0,18,0,12" VerticalAlignment="Top" />
            </DockPanel>
        </Border>

        <!-- Deadlines -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="32,20,32,8">
                <Button DockPanel.Dock="Right" Command="ApplicationCommands.New" VerticalAlignment="Top" Padding="16,7"
                        Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="New deadline (Ctrl+N)" AutomationProperties.Name="New deadline">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="New deadline" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" VerticalAlignment="Top" Padding="10,9" Margin="0,0,8,0"
                        Click="OnThemeClick" AutomationProperties.Name="Theme">
                    <TextBlock x:Name="ThemeGlyph" Style="{StaticResource IconText}" FontSize="14" Text="&#xE770;" />
                </Button>
                <StackPanel x:Name="ListHeader">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ListTitle" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold" />
                        <Button x:Name="ShowAllButton" Style="{StaticResource LinkButton}" Content="Show all" Margin="10,4,0,0"
                                VerticalAlignment="Center" Visibility="Collapsed" Click="OnShowAllClick" />
                    </StackPanel>
                    <TextBlock x:Name="ListSubtitle" Style="{StaticResource CaptionText}" FontSize="13" Margin="1,2,0,0" />
                </StackPanel>
            </DockPanel>

            <Border x:Name="NotificationWarning" Grid.Row="1" Visibility="Collapsed" Margin="32,4,32,4"
                    Padding="12,8" CornerRadius="6"
                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                <TextBlock x:Name="NotificationWarningText" TextWrapping="Wrap" />
            </Border>

            <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="32,0,26,16">
                    <Border x:Name="AllClear" Visibility="Collapsed" Margin="0,10,0,4" Padding="14,12" CornerRadius="8"
                            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE930;" FontSize="16" Margin="0,0,10,0"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="You're all caught up." VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ItemsControl x:Name="Sections" ItemTemplate="{StaticResource SectionTemplate}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,40"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE787;" FontSize="28" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource CaptionText}" FontSize="13" HorizontalAlignment="Center" />
                <Button x:Name="EmptyAddButton" Content="Add a deadline on this day" HorizontalAlignment="Center"
                        Margin="0,16,0,0" Padding="14,6" Click="OnEmptyAddClick" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
