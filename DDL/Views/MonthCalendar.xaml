<UserControl x:Class="DDL.Views.MonthCalendar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DDL.ViewModels"
             ClipToBounds="True">

    <UserControl.Resources>
        <DataTemplate x:Key="DotTemplate">
            <Ellipse x:Name="Dot" Width="5" Height="5" Margin="1.5,0"
                     Fill="{DynamicResource AccentFillColorDefaultBrush}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="{x:Static vm:Urgency.Overdue}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static vm:Urgency.Soon}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Static vm:Urgency.Done}">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="DayTemplate" DataType="{x:Type vm:CalendarDay}">
            <Button x:Name="DayButton" Style="{StaticResource BareButton}" Cursor="Hand"
                    Click="OnDayClick" MouseDoubleClick="OnDayDoubleClick"
                    ToolTip="{Binding Tooltip}" AutomationProperties.Name="{Binding AutomationName}">
                <Border x:Name="Cell" Height="42" Margin="1" CornerRadius="8" BorderThickness="1.5"
                        Background="Transparent" BorderBrush="Transparent">
                    <StackPanel VerticalAlignment="Center">
                        <Grid Width="26" Height="26" HorizontalAlignment="Center">
                            <Ellipse x:Name="TodayDisc" Visibility="Collapsed"
                                     Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="DayText" Text="{Binding DayNumber}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl x:Name="Dots" ItemsSource="{Binding Dots}" Height="5" Margin="0,3,0,0"
                                      HorizontalAlignment="Center" Focusable="False"
                                      ItemTemplate="{StaticResource DotTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInMonth}" Value="False">
                    <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter TargetName="Dots" Property="Opacity" Value="0.5" />
                </DataTrigger>
                <Trigger SourceName="DayButton" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger SourceName="DayButton" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="TodayDisc" Property="Visibility" Value="Visible" />
                    <Setter TargetName="DayText" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter TargetName="DayText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="6,0,0,6">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76C;"
                    Click="OnNextMonthClick" ToolTip="Next month" AutomationProperties.Name="Next month" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE76B;"
                    Click="OnPreviousMonthClick" ToolTip="Previous month" AutomationProperties.Name="Previous month" />
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Today" Margin="0,0,2,0"
                    Click="OnTodayClick" ToolTip="Jump to today" />
            <TextBlock x:Name="MonthTitle" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ItemsControl x:Name="WeekdayHeader" Focusable="False" Margin="0,0,0,2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="11" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ItemsControl x:Name="Days" ItemTemplate="{StaticResource DayTemplate}" Focusable="False"
                      KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained"
                      AutomationProperties.Name="Calendar days">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7" Rows="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
