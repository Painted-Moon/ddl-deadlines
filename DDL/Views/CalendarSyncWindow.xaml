<Window x:Class="DDL.Views.CalendarSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DDL" AutomationProperties.AutomationId="CalendarSync"
        Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <StackPanel Margin="28,14,28,24">
        <TextBlock Text="Outlook sync" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource CaptionText}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="DDL publishes your deadlines as a calendar that Outlook subscribes to. After a one-time setup, new or changed deadlines show up in Outlook by themselves. Outlook checks for changes every few hours." />

        <Border Style="{StaticResource StatTile}" Margin="0,16,0,0" Padding="16,12,16,14">
            <StackPanel>
                <CheckBox x:Name="EnabledBox" Content="Keep the calendar up to date"
                          Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                <CheckBox x:Name="CompletedBox" Content="Include completed deadlines" Margin="0,6,0,0"
                          Checked="OnOptionChanged" Unchecked="OnOptionChanged" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock x:Name="PathText" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Show file" Margin="10,0,0,0" VerticalAlignment="Center"
                            Click="OnShowFolderClick" ToolTip="Show the local copy of the calendar file" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="Connect Outlook (one time)" FontSize="15" FontWeight="SemiBold" Margin="0,22,0,10" />

        <!-- Shown until a gist exists -->
        <StackPanel x:Name="SetupPanel">
            <TextBlock TextWrapping="Wrap" FontSize="13">
                <Run FontWeight="SemiBold" Text="1." />
                <Run Text="DDL keeps the calendar in a secret gist on your GitHub account. Create a token that can only manage gists: on the page, pick an expiration, click Generate token, and copy it." />
            </TextBlock>
            <Button Content="Open GitHub" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,5"
                    Click="OnOpenGitHubClick" ToolTip="Opens github.com in your browser" />

            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,14,0,6">
                <Run FontWeight="SemiBold" Text="2." />
                <Run Text="Paste the token and connect:" />
            </TextBlock>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="TokenBox" PasswordChanged="OnTokenChanged" AutomationProperties.Name="GitHub token" />
                <Button x:Name="ConnectButton" Grid.Column="1" Content="Connect" MinWidth="88" Margin="8,0,0,0"
                        IsEnabled="False" Click="OnConnectClick" Style="{DynamicResource AccentButtonStyle}" />
            </Grid>
            <TextBlock x:Name="ConnectText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <!-- Shown once connected -->
        <StackPanel x:Name="ConnectedPanel" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Disconnect"
                        Click="OnDisconnectClick" ToolTip="Stop updating the gist and forget the token" />
                <TextBlock x:Name="ConnectedText" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>

            <TextBlock TextWrapping="Wrap" FontSize="13" Margin="0,12,0,6"
                       Text="In Outlook, open Calendar, choose Add calendar, then Subscribe from web. Paste this address and name the calendar DDL:" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SubscribeBox" IsReadOnly="True" AutomationProperties.Name="Subscribe address" />
                <Button x:Name="CopyButton" Grid.Column="1" Content="Copy" MinWidth="72" Margin="8,0,0,0" Click="OnCopyClick" />
            </Grid>
            <TextBlock x:Name="CheckText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <Border Margin="0,16,0,0" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="The gist is secret: it isn't listed or searchable on GitHub, but anyone who has the address can see your deadline titles and times (never your notes). The token is stored encrypted for your Windows account only." />
        </Border>

        <Button Content="Done" HorizontalAlignment="Right" MinWidth="96" Margin="0,20,0,0"
                IsDefault="True" IsCancel="True" Style="{DynamicResource AccentButtonStyle}" />
    </StackPanel>
</Window>
